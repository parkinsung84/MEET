# cp .env.example .env 후 값을 채우세요. (.env 는 git에 올라가지 않습니다)
PORT=3000
DB_PATH=meet.db
JWT_SECRET=충분히-긴-임의의-문자열로-바꾸세요

# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps  (지도 표시, 주소 검색, 좌표→주소, 길찾기/택시요금)
NAVER_MAP_KEY_ID=
NAVER_MAP_KEY=

# 네이버 개발자센터(developers.naver.com) > 검색 API  (장소명 검색: "스타벅스 강남역점" 등)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 이메일 인증 메일 발송 (없으면 콘솔에 인증번호 출력 — 개발용)
# 예) Gmail: smtps://아이디%40gmail.com:앱비밀번호@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=MEET <no-reply@example.com>

# 웹 푸시(VAPID) 키 — 비워두면 처음 실행 시 자동 생성해 DB에 저장합니다.
# 서버를 여러 대 운영하거나 DB를 새로 만들 때 구독이 끊기지 않게 하려면 고정값을 넣으세요:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# production 으로 설정하면 개발용 인증번호 노출이 꺼집니다 (운영 필수)
NODE_ENV=development

# 휴대폰 인증문자 (네이버 클라우드 SENS) — 비우면 콘솔에 인증번호 출력 (개발용)
# 콘솔 > Simple & Easy Notification Service 에서 프로젝트 생성 + 발신번호 등록
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SENS_SERVICE_ID=
SMS_FROM=

# 음성 통화 TURN 서버 (모바일망 연결 보장용, 선택)
# coturn: static-auth-secret 과 같은 값을 TURN_SECRET 에 넣으면 사용자별 임시 계정 발급
TURN_URLS=
TURN_SECRET=
# STUN_URLS=stun:stun.l.google.com:19302
