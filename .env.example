# cp .env.example .env 후 값을 채우세요. (.env 는 git에 올라가지 않습니다)
PORT=3000
DB_PATH=meet.db
JWT_SECRET=충분히-긴-임의의-문자열로-바꾸세요

# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps  (지도 표시, 주소 검색, 좌표→주소, 길찾기/택시요금)
NAVER_MAP_KEY_ID=
NAVER_MAP_KEY=

# 네이버 개발자센터(developers.naver.com) > 검색 API  (장소명 검색: "스타벅스 강남역점" 등)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
